import "@stdlib/gas-payments"
import "v2-types"
type RoomMessage = RoomInit | Enter | Leave | Draw | CloseAck | RetryClose | TopUp | ProbeEntry | ReceiptAck | RetryReceipt
contract V2RoomB { storage: RoomStorage incomingMessages: RoomMessage }

fun sendCredit(to: address, amount: coins, role: int) {
    createMessage({ dest: to, value: amount + creditGasFee(), bounce: BounceMode.NoBounce, body: Credit { role, amount } })
        .send(SEND_MODE_PAY_FEES_SEPARATELY | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
}
fun sendEvent(s: RoomStorage, st: RoomState, kind: int, queryId: uint64, wallet: address, partner: address?, value: coins) {
    createMessage({ dest: s.root, value, bounce: BounceMode.Only256BitsOfBody,
        body: RoomEvent { kind, queryId, wallet, partner, creator: s.creator, seq: s.seq, version: st.version } })
        .send(SEND_MODE_PAY_FEES_SEPARATELY | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
}
fun save(mutate s: RoomStorage, st: RoomState) { s.state = st.toCell(); contract.setData(s.toCell()); createExternalLogMessage({dest: createAddressNone(), body: RoomSnapshot { storage: s.toCell() }}).send(SEND_MODE_REGULAR); }
fun sendDraw(value: coins) {
    createMessage({ dest: contract.getAddress(), value, bounce: BounceMode.NoBounce, body: Draw { } })
        .send(SEND_MODE_PAY_FEES_SEPARATELY | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
}
// Unused part of the creator's prepaid rent (upper-bound estimate of rent consumed so far).
fun creatorRentBack(st: RoomState): coins {
    return max(0, rentQuote(RENT_HORIZON) - rentQuote(blockchain.now() - st.createdAt));
}
fun commission(st: RoomState, t: Terms): (coins, coins) {
    val fee = (st.bet * st.capacity - st.bet) * t.feePercent / 100;
    return (fee, fee * t.techBps / 10000);
}
// Amount the next seat must deliver, and the part of a shortfall covered by this Room's own tech share T.
// Equal for every seat; only if tariffs or rent left the pool short does T, then the last seat, cover it.
fun joinNeed(st: RoomState, t: Terms, before: coins): (coins, coins) {
    val standard = st.bet + seatPrice(st.capacity, t.seatMargin);
    if (st.count + 1 < st.capacity) { return (standard, 0); }
    val pool = before + standard - st.bet * st.capacity - joinCost();
    val required = settleCost(st.capacity) + closeCost() + creatorRentBack(st);
    if (pool >= required) { return (standard, 0); }
    val (_, tech) = commission(st, t);
    val short = required - pool;
    if (short <= tech) { return (standard, short); }
    return (standard + short - tech, tech);
}

fun settle(mutate s: RoomStorage, mutate st: RoomState, d: DrawState, caller: address?, callerValue: coins) {
    random.initialize();
    random.initializeBy(d.entropy);
    val t = st.terms.load(); val a = t.addrs.load(); val refs = t.refs.load();
    val n = st.count as int;
    val winnerIndex = random.range(n);
    val bank = st.bet * n;
    val (fee, tech) = commission(st, t);
    val distributable = fee - tech;
    var shares: map<address, coins> = createEmptyMap();
    var affiliates: coins = 0; var i = 0; var winner = s.creator;
    var it = st.seats.findFirst();
    while (it.isFound) {
        if (i == winnerIndex) { winner = it.getKey(); }
        val seat = it.loadValue();
        if (seat.partner != null && t.partnersEnabled) {
            val bps = seat.bps == DEFAULT_BPS ? t.partnerBps : seat.bps;
            val amount = distributable * bps / (n * 10000);
            if (amount > 0) {
                val old = shares.get(seat.partner!);
                shares.set(seat.partner!, (old.isFound ? old.loadValue() : (0 as coins)) + amount);
                affiliates += amount;
            }
        }
        i += 1; it = st.seats.iterateNext(it);
    }
    var investorAmount: coins = 0;
    if (a.investor != null) { investorAmount = (distributable - affiliates) * t.investorBps / 10000; }
    val ownerAmount = distributable - affiliates - investorAmount;
    val techSend = tech - d.techCover;
    createExternalLogMessage({dest: createAddressNone(), body: RoomSettled { winner, amount: bank - fee, storage: s.toCell() }}).send(SEND_MODE_REGULAR);
    payPlain(winner, bank - fee, "TonRooms.app: payout");
    if (t.surplusToWinner && techSend > 0) { payPlain(a.techFund, techSend, "TonRooms.app: tech fund"); }
    var sh = shares.findFirst();
    while (sh.isFound) { sendCredit(accountAt(s.root, sh.getKey(), refs), sh.loadValue(), 1); sh = shares.iterateNext(sh); }
    if (investorAmount > 0) { sendCredit(accountAt(s.root, a.investor!, refs), investorAmount, 2); }
    if (ownerAmount > 0) { sendCredit(accountAt(s.root, t.owner, refs), ownerAmount, 3); }
    sendEvent(s, st, EVENT_CLOSED, 0, s.creator, null, closeNoteValue());
    if (caller != null && callerValue > 0) { payPlain(caller!, callerValue, "TonRooms.app: draw trigger refund"); }
    st.phase = PHASE_CLOSING; st.seats = createEmptyMap(); st.draw = null;
    save(mutate s, st);
    // The creator's unused rent and the CloseAck budget stay; the rest is the technical remainder.
    reserveGramsOnBalance(ackKeep() + creatorRentBack(st) + (st.receiptCount > 0 ? RECEIPT_KEEP : 0), RESERVE_MODE_AT_MOST | RESERVE_MODE_BOUNCE_ON_ACTION_FAIL);
    val restTo = t.surplusToWinner ? winner : a.techFund;
    createMessage({ dest: restTo, value: 0, bounce: BounceMode.NoBounce,
        body: comment(t.surplusToWinner ? "TonRooms.app: technical remainder" : "TonRooms.app: tech fund") })
        .send(SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_IGNORE_ERRORS);

}

fun finishClose(s: RoomStorage, st: RoomState) {
    if (st.phase != PHASE_CLOSING || !st.creatorClosed || st.receiptCount != 0) { return; }
    createMessage({ dest: s.creator, value: 0, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: room closed") })
        .send(SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_DESTROY | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
}

fun onInternalMessage(in: InMessage) {
    if (in.body.isEmpty()) { return; }
    val msg = lazy RoomMessage.fromSlice(in.body);
    var s = RoomStorage.fromCell(contract.getData());
    match (msg) {
        RoomInit => {
            assert (in.senderAddress == s.root && s.state == null && msg.wallet == s.creator) throw E_AUTH;
            assert (blockchain.now() <= msg.deadline) throw E_DEADLINE;
            val q = msg.params.load(); val t = msg.terms.load();
            assert (q.seq == s.seq && q.capacity >= MIN_CAPACITY && q.capacity <= MAX_CAPACITY) throw E_POLICY;
            val price = seatPrice(q.capacity, t.seatMargin);
            val buffer = roomBuffer();
            val note = noteValue();
            val need = q.bet + price + buffer + note;
            assert (in.valueCoins >= need) throw E_VALUE;
            if (in.valueCoins - need > EXCESS_MIN) {
                createMessage({ dest: msg.wallet, value: in.valueCoins - need, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: create excess") })
                    .send(SEND_MODE_REGULAR | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
            }
            var seats: map<address, Seat> = createEmptyMap();
            seats.set(msg.wallet, Seat { partner: msg.partner, bps: msg.bps, deposit: price - joinCost() });
            var receipts: map<address, Receipt> = createEmptyMap();
            receipts.set(msg.wallet, Receipt { queryId: msg.queryId, partner: msg.partner });
            val st = RoomState { phase: PHASE_OPEN, bet: q.bet, capacity: q.capacity, isPrivate: q.isPrivate, count: 1,
                version: msg.version, createdAt: blockchain.now(), buffer, creatorProfile: msg.creatorProfile,
                terms: msg.terms, seats, draw: null, receipts, receiptCount: 1, creatorClosed: false };
            sendEvent(s, st, EVENT_ACCEPTED, msg.queryId, msg.wallet, msg.partner, note);
            save(mutate s, st);
        }
        Enter => {
            val e = msg;
            assert (blockchain.now() <= e.deadline) throw E_DEADLINE;
            // Root authenticated the Profile/Account and derived this address.
            // A refusal is a throw: the entry bounces to Root, then to the Profile, then to the wallet.
            assert (in.senderAddress == s.root && s.state != null && e.join != null) throw E_AUTH;
            var st = s.state!.load(); val t = st.terms.load();
            assert (st.phase == PHASE_OPEN) throw E_STATE;
            assert (st.count < st.capacity) throw E_FULL;
            assert (!st.seats.exists(e.wallet)) throw E_SEATED;
            val note = noteValue();
            assert (st.receiptCount < 10 && !st.receipts.exists(e.wallet)) throw E_PENDING;
            val (need, techCover) = joinNeed(st, t, contract.getOriginalBalance() - in.valueCoins);
            assert (in.valueCoins >= need + note) throw E_VALUE;
            var partner: address? = null; var bps: uint16 = 0;
            if (e.stamped && e.registered) { partner = e.partner; bps = e.eligible ? e.bps : 0; }
            if (in.valueCoins - need - note > EXCESS_MIN) {
                createMessage({ dest: e.wallet, value: in.valueCoins - need - note, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: entry excess") })
                    .send(SEND_MODE_REGULAR | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
            }
            st.receipts.set(e.wallet, Receipt { queryId: e.queryId, partner }); st.receiptCount += 1;
            sendEvent(s, st, EVENT_ACCEPTED, e.queryId, e.wallet, partner, note);
            st.seats.set(e.wallet, Seat { partner, bps, deposit: seatPrice(st.capacity, t.seatMargin) - joinCost() });
            st.count += 1;
            if (st.count == st.capacity) {
                // Filled: no leave or cancel any more. The draw happens in a strictly later block.
                random.initialize();
                st.phase = PHASE_DRAWING;
                st.draw = DrawState { fillBlockLt: blockchain.currentBlockLogicalTime(), entropy: random.getSeed(), hops: 0, techCover }.toCell();
                sendDraw(calculateGasFee(0, SETTLE_GAS_BASE + st.capacity * SETTLE_GAS_SEAT));
            }
            save(mutate s, st);
        }
        Draw => {
            assert (s.state != null) throw E_STATE;
            var st = s.state!.load();
            val fromSelf = in.senderAddress == contract.getAddress();
            if (st.phase != PHASE_DRAWING) { assert (fromSelf) throw E_STATE; return; }
            var d = st.draw!.load();
            if (blockchain.currentBlockLogicalTime() <= d.fillBlockLt) {
                assert (fromSelf) throw E_STATE;
                if (d.hops < DRAW_SELF_HOPS) { d.hops += 1; sendDraw(in.valueCoins); }
                st.draw = d.toCell(); save(mutate s, st);
                return;
            }
            val budget = calculateGasFee(0, SETTLE_GAS_BASE + st.capacity * SETTLE_GAS_SEAT) + 2 * noteFwd();
            if (!fromSelf) { assert (in.valueCoins >= budget) throw E_VALUE; }
            settle(mutate s, mutate st, d, fromSelf ? null : in.senderAddress, fromSelf ? (0 as coins) : in.valueCoins - budget);
        }
        Leave => {
            assert (s.state != null) throw E_STATE;
            var st = s.state!.load();
            assert (st.phase == PHASE_OPEN) throw E_STATE;
            val seat = st.seats.mustGet(in.senderAddress, E_AUTH);
            if (in.senderAddress == s.creator) {
                // Cancel: only when the creator is alone. Everything except the closing reserve goes back now.
                assert (st.count == 1) throw E_STATE;
                st.phase = PHASE_CLOSING; st.seats = createEmptyMap(); st.count = 0;
                save(mutate s, st);
                sendEvent(s, st, EVENT_CLOSED, 0, s.creator, null, closeNoteValue());
                payPlain(s.creator, st.bet + seat.deposit + creatorRentBack(st), "TonRooms.app: room cancelled refund");
                reserveGramsOnBalance(ackKeep() + (st.receiptCount > 0 ? RECEIPT_KEEP : 0), RESERVE_MODE_AT_MOST | RESERVE_MODE_BOUNCE_ON_ACTION_FAIL);
                createMessage({ dest: st.terms.load().addrs.load().techFund, value: 0, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: unused maintenance reserve") })
                    .send(SEND_MODE_CARRY_ALL_BALANCE | SEND_MODE_IGNORE_ERRORS);
                return;
            }
            st.seats.delete(in.senderAddress); st.count -= 1;
            save(mutate s, st);
            // Never silently pay a smaller stake. If maintenance funding is missing,
            // keep the seat intact until a funded retry can return the complete amount.
            val before = contract.getOriginalBalance() - in.valueCoins;
            val refund = st.bet + seat.deposit;
            assert (before >= refund + st.bet * st.count + ackKeep()) throw E_VALUE;
            reserveExact(st.bet * st.count + ackKeep());
            createMessage({ dest: in.senderAddress, value: refund, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: stake refund") })
                .send(SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
        }
        CloseAck => {
            assert (s.state != null) throw E_STATE;
            var st = s.state!.load();
            assert (in.senderAddress == st.creatorProfile && msg.seq == s.seq && st.phase == PHASE_CLOSING) throw E_AUTH;
            st.creatorClosed = true; save(mutate s, st);
            finishClose(s, st);
        }
        ReceiptAck => {
            assert (s.state != null) throw E_STATE;
            var st = s.state!.load();
            assert (in.senderAddress == profileAt(s.root, msg.wallet, st.terms.load().refs.load())) throw E_AUTH;
            val receipt = st.receipts.get(msg.wallet);
            if (receipt.isFound && receipt.loadValue().queryId == msg.queryId) {
                st.receipts.delete(msg.wallet); st.receiptCount -= 1;
            }
            save(mutate s, st); finishClose(s, st);
        }
        RetryReceipt => {
            assert (s.state != null && in.valueCoins >= noteValue() + calculateGasFee(0, 12000)) throw E_VALUE;
            val st = s.state!.load(); val receipt = st.receipts.mustGet(msg.wallet, E_STATE);
            createMessage({ dest: s.root, value: 0, bounce: BounceMode.NoBounce,
                body: RoomEvent { kind: EVENT_ACCEPTED, queryId: receipt.queryId, wallet: msg.wallet,
                    partner: receipt.partner, creator: s.creator, seq: s.seq, version: st.version } })
                .send(SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
        }
        ProbeEntry => {
            assert (in.senderAddress == s.root) throw E_AUTH;
            val e = msg.original.load();
            assert (blockchain.now() > e.deadline) throw E_DEADLINE;
            var version: uint32 = 0;
            if (e.create != null) {
                val q = e.create!.load(); assert (e.wallet == s.creator && q.seq == s.seq) throw E_AUTH; version = q.version;
            } else {
                val q = e.join!.load(); assert (q.creator == s.creator && q.seq == s.seq) throw E_AUTH; version = q.version;
            }
            var kind = EVENT_FAILED; var partner: address? = null;
            if (s.state != null) {
                val st = s.state!.load(); assert (st.version == version) throw E_VERSION;
                val receipt = st.receipts.get(e.wallet);
                if (receipt.isFound && receipt.loadValue().queryId == e.queryId) {
                    kind = EVENT_ACCEPTED; partner = receipt.loadValue().partner;
                }
            }
            // An empty canonical Room can disappear: all deliveries of this entry
            // now fail its deadline, so this negative result cannot race acceptance.
            val note = noteValue();
            createMessage({ dest: s.root, value: note, bounce: BounceMode.NoBounce,
                body: RoomEvent { kind, queryId: e.queryId, wallet: e.wallet, partner, creator: s.creator, seq: s.seq, version } })
                .send(SEND_MODE_PAY_FEES_SEPARATELY | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
            if (s.state != null) { reserveExact(max(0, contract.getOriginalBalance() - in.valueCoins)); }
            createMessage({ dest: msg.excessTo, value: 0, bounce: BounceMode.NoBounce, body: comment("TonRooms.app: recovery budget return") })
                .send(SEND_MODE_CARRY_ALL_BALANCE | (s.state == null ? SEND_MODE_DESTROY : 0) | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
        }
        RetryClose => {
            // Anyone may repeat the closing notice at their own cost; the Room waits for CloseAck.
            assert (s.state != null) throw E_STATE;
            val st = s.state!.load();
            assert (st.phase == PHASE_CLOSING) throw E_STATE;
            assert (in.valueCoins >= closeNoteValue()) throw E_VALUE;
            createMessage({ dest: s.root, value: 0, bounce: BounceMode.Only256BitsOfBody,
                body: RoomEvent { kind: EVENT_CLOSED, queryId: 0, wallet: s.creator, partner: null, creator: s.creator, seq: s.seq, version: st.version } })
                .send(SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);
        }
        TopUp => {
            assert (s.state != null) throw E_STATE;
            var st = s.state!.load();
            assert (st.phase == PHASE_OPEN) throw E_STATE;
            st.buffer += in.valueCoins;
            save(mutate s, st);
        }
    }
}
get fun get_room(): (int, int, int, int, int, int, int, int) {
    val s = RoomStorage.fromCell(contract.getData());
    if (s.state == null) { return (-1, 0, 0, 0, 0, 0, 0, 0); }
    val st = s.state!.load(); val t = st.terms.load();
    return (st.phase, st.bet, st.capacity, st.count, seatPrice(st.capacity, t.seatMargin), settleCost(st.capacity), st.buffer, st.version);
}
// Exact amount the next seat must deliver at the Room (without the first-stake notice).
get fun get_join_value(): (int, int) {
    val s = RoomStorage.fromCell(contract.getData());
    if (s.state == null) { return (-1, 0); }
    val st = s.state!.load();
    if (st.phase != PHASE_OPEN) { return (-1, 0); }
    return joinNeed(st, st.terms.load(), contract.getOriginalBalance());
}
get fun get_draw(): (int, int, int) {
    val s = RoomStorage.fromCell(contract.getData());
    if (s.state == null) { return (-1, 0, 0); }
    val st = s.state!.load();
    if (st.draw == null) { return (st.phase, 0, 0); }
    val d = st.draw!.load();
    return (d.fillBlockLt, d.hops, d.techCover);
}
get fun get_note_value(): int { return noteValue(); }
get fun get_room_buffer(): int { return roomBuffer(); }

get fun get_state(): Cell<RoomState>? { return RoomStorage.fromCell(contract.getData()).state; }
get fun get_receipts(): cell { val s = RoomStorage.fromCell(contract.getData()); return s.state!.load().receipts.toLowLevelDict() ?? beginCell().endCell(); }
get fun get_draw_value(): int { val s = RoomStorage.fromCell(contract.getData()); val st = s.state!.load(); return calculateGasFee(0, SETTLE_GAS_BASE + st.capacity * SETTLE_GAS_SEAT) + 2 * noteFwd(); }

// Retry budget includes the closing notice plus processing at this Room.
get fun get_close_value(): int { return closeNoteValue() + calculateGasFee(0, 12000) + noteFwd(); }
get fun get_room_code_variant(): int { return 2; }
